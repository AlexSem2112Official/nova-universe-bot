# Токен от @BotFather (обязательно). Если токен светился в чате — сначала сделайте /revoke.
BOT_TOKEN=

# Необязательно: общий ключ OpenRouter, чтобы бот работал у пользователей без своего ключа
DEFAULT_OPENROUTER_KEY=
DEFAULT_MODEL=openrouter/auto

# Необязательно: ограничить доступ (ID через запятую). Пусто = бот открыт всем
ALLOWED_USERS=

# Необязательно: ключ шифрования пользовательских API-ключей (иначе создастся data/secret.key)
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# 1 = разрешить свои провайдеры по http и в локальной сети (например, Ollama). Только для личного бота!
ALLOW_PRIVATE_URLS=0

# Папка с данными (на Render — путь к постоянному диску)
DATA_DIR=data

# Сколько символов истории сессии отправляется модели (по умолчанию 60000)
HISTORY_CHARS=60000

# --- Бесплатный Render (задаётся автоматически ноутбуком) ---
# PORT и RENDER_EXTERNAL_URL выдаёт сам Render; по ним бот поднимает /health и пингует сам себя
# Резервная копия БД в приватный GitHub-репозиторий (диск на free-плане стирается)
BACKUP_GITHUB_TOKEN=
BACKUP_REPO=
BACKUP_INTERVAL=300
